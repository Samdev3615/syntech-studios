# Auto detect text files and perform LF normalization
* text=auto

# Line ending configuration
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# GitHub Linguist configuration
# Exclude generated files and documentation from language statistics
*.md linguist-documentation
*.svg linguist-generated=true
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
drizzle.config.ts linguist-vendored
*.config.js linguist-vendored
*.config.ts linguist-vendored

# Mark TypeScript as primary language
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
