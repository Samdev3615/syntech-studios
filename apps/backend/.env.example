NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-project.vercel.app

# Database (Neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Security — generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
ENCRYPTION_KEY=your-64-hex-chars-here
JWT_SECRET=your-min-32-chars-secret-here

# Cloudflare R2 (optionnel — pour l'upload de fichiers)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# CORS (ajouter l'URL Vercel en production)
CORS_ORIGINS=https://your-project.vercel.app

# Optionnel
LOG_LEVEL=info
SENTRY_DSN=
