# ========================================
# SYNTECH STUDIOS - Backend Environment
# ========================================

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# ========================================
# DATABASE (PostgreSQL - Neon.tech)
# ========================================
# Format: postgresql://user:password@host:port/database?sslmode=require
# Obtenir sur: https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ========================================
# REDIS (Upstash - REST API)
# ========================================
# Obtenir sur: https://console.upstash.com → Details
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here

# ========================================
# OPENAI API
# ========================================
# Obtenir sur: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

# ========================================
# CLOUDFLARE R2 (File Storage)
# ========================================
# Obtenir sur: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=syntech-uploads
R2_PUBLIC_URL=https://your-bucket.r2.cloudflarestorage.com

# ========================================
# ENCRYPTION & SECURITY
# ========================================
# Générer avec: openssl rand -hex 32
ENCRYPTION_KEY=your_32_bytes_hex_encryption_key_here

# JWT Secret (pour authentification future)
JWT_SECRET=your_jwt_secret_here

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# ========================================
# CORS
# ========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ========================================
# MONITORING (Optionnel)
# ========================================
# Sentry DSN (pour tracking erreurs)
SENTRY_DSN=

# Log Level
LOG_LEVEL=info
